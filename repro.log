import { kv } from '@nuxthub/kv'
export function createSecondaryStorage() {
  return {
    get: async (key) => kv.get(`_auth:${key}`),
    set: async (key, value, ttl) => kv.set(`_auth:${key}`, value, { ttl }),
    delete: async (key) => kv.del(`_auth:${key}`),
  }
}


